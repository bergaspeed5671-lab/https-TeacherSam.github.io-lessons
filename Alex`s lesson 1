</div>

<script>
  // Multiple-choice selection toggling
  document.querySelectorAll('.choices').forEach(group=>{
    group.addEventListener('click', (e)=>{
      const choice = e.target.closest('.choice');
      if(!choice) return;
      group.querySelectorAll('.choice').forEach(c=>c.classList.remove('selected'));
      choice.classList.add('selected');
      updateProgress();
    });
  });

  // Scrollspy for side tabs
  const tabs = document.querySelectorAll('.tab');
  const sections = Array.from(tabs).map(t=>document.getElementById(t.dataset.target)).filter(Boolean);
  tabs.forEach(t=>t.addEventListener('click', (e)=>{
    e.preventDefault();
    document.getElementById(t.dataset.target).scrollIntoView({behavior:'smooth'});
  }));
  const spy = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      const tab = document.querySelector(`.tab[data-target="${entry.target.id}"]`);
      if(!tab) return;
      if(entry.isIntersecting){
        tabs.forEach(t=>t.classList.remove('active'));
        tab.classList.add('active');
      }
    });
  }, {rootMargin:'-20% 0px -70% 0px'});
  sections.forEach(s=>spy.observe(s));

  // Progress tracker across text inputs/textareas + selected choices
  function updateProgress(){
    const fields = document.querySelectorAll('main textarea, main input[type="text"].blank-input');
    let filled = 0;
    fields.forEach(f=>{ if(f.value.trim().length>0) filled++; });
    const choiceGroups = document.querySelectorAll('.choices');
    let choicesAnswered = 0;
    choiceGroups.forEach(g=>{ if(g.querySelector('.choice.selected')) choicesAnswered++; });
    const total = fields.length + choiceGroups.length;
    const done = filled + choicesAnswered;
    document.getElementById('progressPill').textContent = `${done} of ${total} answered`;
  }
  document.querySelectorAll('main textarea, main input[type="text"].blank-input').forEach(f=>{
    f.addEventListener('input', updateProgress);
  });
  updateProgress();
</script>
